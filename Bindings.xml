<Bindings>
	<Binding name="HUDFADE_TOGGLE" header="HUDFADE" category="ADDONS">
		HUDFade.Toggle()
	</Binding>
	<Binding name="HUDFADE_PEEK" runOnUp="true" category="ADDONS">
		HUDFade.Peek(keystate == "down")
	</Binding>
	<Binding name="HUDFADE_SCREENSHOT" category="ADDONS">
		HUDFade.CleanScreenshot()
	</Binding>
	<Binding name="HUDFADE_ENABLE" category="ADDONS">
		HUDFade.ToggleEnabled()
	</Binding>
	<Binding name="HUDFADE_PAN" category="ADDONS">
		HUDFade.TogglePan()
	</Binding>
</Bindings>
